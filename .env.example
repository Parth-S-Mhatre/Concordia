# NVIDIA NIM API Key (server-side only, never expose to frontend)
NVIDIA_NIM_API_KEY=

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Auth (Email/Password provider must be enabled in console)
# Web API key: Firebase console → Project settings → General
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Gate the API behind sign-in (false keeps the evaluator demo link open)
REQUIRE_AUTH=false
# Demo admin for testing/interviews (created by backend/seed_admin.py)
DEMO_ADMIN_EMAIL=admin@concordia.demo
DEMO_ADMIN_PASSWORD=Concordia-Admin-2026

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Processing
BATCH_SIZE=1000
MAX_FILE_SIZE_MB=50